# ============================================================
# Vesuvius-C .gitignore
# ============================================================

# ------ Build output (MSVC) ------
build/
/build-*/
*.obj
*.exe
*.pdb
*.ilk
*.lib
*.exp
*.iobj
*.ipdb
*.idb
*.tlog
*.recipe
*.lastbuildstate
*.Build.CppClean.log
*.FileListAbsolute.txt
*.log

# ------ Build output (GCC/Linux) ------
*.o
*.a
*.so
*.d

# ------ Compiled binaries (Linux ELF at repo root) ------
/tif2mip
/tif2obj
/tif2png

# ------ Linux build binaries (src/, from the Makefile) ------
/src/cube_mesh
/src/grid_weld
/src/grid_pipeline
/src/test_common

# ------ IDE ------
.vs/
.vscode/
*.vcxproj.user
*.suo
*.sdf
*.opensdf
*.cachefile
ipch/

# ------ Claude Code ------
.claude/

# ------ CMake artifacts (anywhere in tree) ------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake

# ------ Experiment output & data ------
output/*
!output/canonical_best/
nnunet-preds/
test_sheets/

# ------ Dependencies: build artifacts ------
# Project-local Rust/rustup installation used by the optional CubeCL MLS build
.toolchains/
# Pre-built executables (PoissonRecon is 165 MB)
deps/bin/
# Windows-built static libs (rebuilt from deps/src/)
deps/lib/win64/
# Linux-built static libs (rebuilt from deps/src/)
deps/lib/*.a
# CMake build directories within vendored sources
deps/src/tiff-4.7.1/bld/
deps/src/Clipper2/CPP/build/
deps/src/zlib/build/

# ------ Compiled scripts/tools (Linux ELF binaries) ------
scripts/tif_slices
scripts/step0.5-2d-trace/gap_fill_2d
scripts/step0.5-2d-trace/test_optical_flow

# ------ Ground truth data (large binaries) ------
gt/
TRAIN_LABELS/
# Glob catches every PHerc grid dir (4x5x5, 4x21x21-cubes, future ones). Cube
# TIFs live inside these (cubes_PRED/, cubes_RAW/), so no broad *.tif rule is
# needed -- and *.tif/*.tiff would wrongly shadow the tracked libtiff test
# fixtures under deps/src/tiff-4.7.1/test/images/.
PHerc0139-*/
PHerc0139-*.zip
PHerc1447-*/
PHerc1203-*/

# ------ Python cache ------
__pycache__/
.pytest_cache/
pytest-cache-files-*/

# ------ Metric solver: build artifacts ------
metric-windows/build/
metric-windows/topological-metrics-kaggle/external/Betti-Matching-3D/build_py/
*.pyd

# ------ Backup / temp files ------
*.bak
*.bak[0-9]*
*.backup
*.orig
*.swp
*~

# Reference papers (local only; cited by name+URL in changelog)
papers/

# ------ Archived fixture payloads (manifest + README stay tracked) ------
archive/*/placed/
archive/*/*.csv
archive/*/*.json

# ------ Temp/scratch trees (not part of the repo) ------
.tmp_scrollfiesta/
.debug_images/
tmp/
# CubeCL MLS experiment tree (668 MB incl. Rust build artifacts; separate track)
deps/scrollfiesta-mls-cubecl/

# ------ Public sample/output and local build exclusions ------
!sample_outputs/**/*.obj
runs/
*.tifxyz/
.DS_Store
deps/build-clipper2/

# ------ LaTeX build products (submission.pdf at the repo root is canonical) ------
submission_update/submission.pdf
submission_update/*.aux
submission_update/*.bbl
submission_update/*.blg
submission_update/*.fdb_latexmk
submission_update/*.fls
submission_update/*.log
submission_update/*.out
submission_update/*.synctex.gz

# Only the curated canonical bundle is committed, including its snapped and
# final-relaxed review artifacts. All probe, ablation, worker, and duplicated
# per-cube output remains ignored.
!output/canonical_best/**
