bin/
lib/
obj/

# build/ holds no compiler output at all: it is what TAUCS's configure step
# emits, and every file in it is source the CMake build needs --
#   wrap/*.c              three-line shims, "#define TAUCS_CORE_* / #include"
#   taucs_stubs.c         the LAPACK entry points, so no BLAS wrapper is needed
#   taucs_config_*.h      included by src/taucs.h; without them nothing compiles
#   gen_wrappers.sh       kept for provenance: it is what generated wrap/
# A plain "build/" rule excluded the lot and broke every clean checkout.
build/*
!build/wrap/
!build/*.c
!build/*.h
!build/gen_wrappers.sh
build/wrap/*
!build/wrap/*.c
# ...but if anyone does configure a CMake build in here, keep its output out.
build/CMakeCache.txt
build/CMakeFiles/
configurator/configurator

# makefile in top diretory is generated by configure script
makefile

testscript.log

