bin/
lib/
obj/

# build/ is generated output, with two exceptions that are vendored source:
# the wrap/ shims (three lines each, "#define TAUCS_CORE_* / #include the real
# .c") and taucs_stubs.c. The CMake build compiles those directly, so they have
# to be in the repository -- a plain "build/" rule silently excluded them and
# broke every clean checkout.
build/*
!build/wrap/
!build/taucs_stubs.c
build/wrap/*
!build/wrap/*.c
configurator/configurator

# makefile in top diretory is generated by configure script
makefile

testscript.log

