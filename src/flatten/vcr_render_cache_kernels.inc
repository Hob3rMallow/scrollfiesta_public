/* Fixed surface tiles use exactly the resident kernels' float arithmetic. */
"extern \"C\" __global__ void vcr_mark_rect(const float *X, const float *Y, const float *Z, int W, int H, int flip,\n"
"                                    float omin, float omax, int sz, int sy, int sx, int cgy, int cgx, int r0, int c0, int rh, int cw,\n"
"                                    unsigned stamp, unsigned *seen, unsigned *count, int *keys, unsigned capacity)\n"
"{\n"
"    const int c = c0 + blockIdx.x * blockDim.x + threadIdx.x, r = r0 + blockIdx.y * blockDim.y + threadIdx.y;\n"
"    if (c >= c0 + cw || r >= r0 + rh) return;\n"
"    float b[3], d[3];\n"
"    if (!pixel_geom(X, Y, Z, W, H, r, c, flip, b, d)) return;\n"
"    if (!((b[0] == b[0]) & (b[1] == b[1]) & (b[2] == b[2]))) return;\n"
"    const int lim[3] = {sx, sy, sz};\n"
"    int lo[3], hi[3];\n"
"    for (int k = 0; k < 3; k++) {\n"
"        const float e1 = __fadd_rn(b[k], __fmul_rn(d[k], omin)), e2 = __fadd_rn(b[k], __fmul_rn(d[k], omax));\n"
"        const float mn = fminf(e1, e2), mx = fmaxf(e1, e2), top = (float)lim[k] + 4.0f;\n"
"        if (!(mx >= -4.0f) || !(mn <= top)) return;\n"
"        lo[k] = max(0, (int)floorf(fmaxf(mn, -4.0f)) - 1);\n"
"        hi[k] = min(lim[k] - 1, (int)floorf(fminf(mx, top)) + 2);\n"
"        if (lo[k] > hi[k]) return;\n"
"    }\n"
"    for (int cz = lo[2] >> 7; cz <= hi[2] >> 7; cz++)\n"
"        for (int cy = lo[1] >> 7; cy <= hi[1] >> 7; cy++)\n"
"            for (int cx = lo[0] >> 7; cx <= hi[0] >> 7; cx++)\n"
"                {\n"
"                    const int key = (cz * cgy + cy) * cgx + cx;\n"
"                    if (atomicExch(seen + key, stamp) != stamp) {\n"
"                        const unsigned n = atomicAdd(count, 1u);\n"
"                        if (n < capacity) keys[n] = key;\n"
"                    }\n"
"                }\n"
"}\n"
"\n"
"extern \"C\" __global__ void vcr_layers_rect(const float *X, const float *Y, const float *Z, int W, int H, int flip,\n"
"                                      int r0, int c0, int rh, int cw, const int *tab, const u8 *pool, int sz, int sy, int sx, int cgy,\n"
"                                      int cgx, const float *offs, int N, u8 *out)\n"
"{\n"
"    const int c = c0 + blockIdx.x * blockDim.x + threadIdx.x, ly = r0 + blockIdx.y * blockDim.y + threadIdx.y;\n"
"    const int r = ly;\n"
"    if (c >= c0 + cw || ly >= r0 + rh) return;\n"
"    float b[3], d[3];\n"
"    const int ok = pixel_geom(X, Y, Z, W, H, r, c, flip, b, d);\n"
"    const float szf = (float)sz, syf = (float)sy, sxf = (float)sx;\n"
"    u8 *o = out + (size_t)(c >> 7) * (size_t)N * 16384u + (size_t)ly * 128u + (size_t)(c & 127);\n"
"    for (int i = 0; i < N; i++) {\n"
"        u8 val = 0;\n"
"        if (ok) {\n"
"            const float off = offs[i];\n"
"            const float px = __fadd_rn(b[0], __fmul_rn(d[0], off));\n"
"            const float py = __fadd_rn(b[1], __fmul_rn(d[1], off));\n"
"            const float pz = __fadd_rn(b[2], __fmul_rn(d[2], off));\n"
"            if (pz >= 0.f && py >= 0.f && px >= 0.f && pz < szf && py < syf && px < sxf) {\n"
"                float v = trilinear(tab, pool, sz, sy, sx, cgy, cgx, pz, py, px);\n"
"                if (v < 0.f) v = 0.f;\n"
"                if (v > 255.f) v = 255.f;\n"
"                val = (u8)(int)v;\n"
"            }\n"
"        }\n"
"        o[(size_t)i * 16384u] = val;\n"
"    }\n"
"}\n"
"\n"
"extern \"C\" __global__ void vcr_ctmax_rect(const float *X, const float *Y, const float *Z, int W, int H, int flip,\n"
"                                     int r0, int c0, int rh, int cw, int stride, int z0, int z1, float zstep, const int *tab, const u8 *pool, int sz, int sy,\n"
"                                     int sx, int cgy, int cgx, u8 *out)\n"
"{\n"
"    const int c = c0 + blockIdx.x * blockDim.x + threadIdx.x, r = r0 + blockIdx.y * blockDim.y + threadIdx.y;\n"
"    if (c >= c0 + cw || r >= r0 + rh) return;\n"
"    float b[3], d[3];\n"
"    u8 val = 0;\n"
"    if (pixel_geom(X, Y, Z, W, H, r, c, flip, b, d) && isfinite(b[0])) {\n"
"        const float szf = (float)sz, syf = (float)sy, sxf = (float)sx;\n"
"        float mx = 0.0f;\n"
"        for (int k = z0; k <= z1; k++) {\n"
"            const float z = __fmul_rn((float)k, zstep);\n"
"            const float px = __fadd_rn(b[0], __fmul_rn(d[0], z));\n"
"            const float py = __fadd_rn(b[1], __fmul_rn(d[1], z));\n"
"            const float pz = __fadd_rn(b[2], __fmul_rn(d[2], z));\n"
"            float v = 0.0f;\n"
"            if (pz >= 0.f && py >= 0.f && px >= 0.f && pz < szf && py < syf && px < sxf) {\n"
"                int iz = (int)__fadd_rn(pz, 0.5f), iy = (int)__fadd_rn(py, 0.5f), ix = (int)__fadd_rn(px, 0.5f);\n"
"                if (iz >= sz) iz = sz - 1;\n"
"                if (iy >= sy) iy = sy - 1;\n"
"                if (ix >= sx) ix = sx - 1;\n"
"                v = vox(tab, pool, sz, sy, sx, cgy, cgx, iz, iy, ix);\n"
"            }\n"
"            mx = fmaxf(mx, v);\n"
"        }\n"
"        if (mx > 255.f) mx = 255.f;\n"
"        val = (u8)(int)mx;\n"
"    }\n"
"    out[(size_t)r * stride + c] = val;\n"
"}\n"
"extern \"C\" __global__ void vcr_patch_table(int *tab, const int *changes, int n)\n"
"{\n"
"    const int i = blockIdx.x * blockDim.x + threadIdx.x;\n"
"    if (i >= n) return;\n"
"    const int old_key = changes[3*i], new_key = changes[3*i+1], slot = changes[3*i+2];\n"
"    if (old_key >= 0) tab[old_key] = -1;\n"
"    tab[new_key] = slot;\n"
"}\n"
